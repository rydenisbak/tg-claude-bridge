# tgbridge config — copy to ~/.config/tgbridge/config.env and:
#   chmod 700 ~/.config/tgbridge && chmod 600 ~/.config/tgbridge/config.env

# --- required ---
TG_BOT_TOKEN=123456789:AA...your-bot-token-from-BotFather...
TG_ALLOWED_ID=123456789          # your numeric Telegram user id (the ONLY allowed user)

# --- agent (defaults shown) ---
#WORKDIR=~                       # agent working directory
#CLAUDE_BIN=~/.local/bin/claude
#PERMISSION_MODE=bypassPermissions
#EFFORT=high                     # low|medium|high|xhigh|max (switchable live via /effort)
#CLAUDE_MODEL=                   # empty = CLI default; e.g. claude-opus-4-8
#CLAUDE_TIMEOUT=1800             # seconds per agent turn

# --- bridge behavior ---
#LONG_LIMIT=6000                 # longer answers are sent as a .md file
#BASH_TIMEOUT=30                 # seconds for !commands
#BASH_ALLOW=ls pwd cat head tail grep rg find echo stat file wc du df ps git python python3 pip conda which whoami hostname date uptime env printenv chmod mkdir touch cp ln tree tgsend

# --- voice / video transcription (optional) ---
#WHISPER_BIN=/path/to/env/bin/whisper
#WHISPER_MODEL=small             # tiny|base|small|medium|large|turbo
#WHISPER_LANG=ru                 # ru|en|auto
#FFMPEG_BIN=                     # default: ffmpeg next to WHISPER_BIN
